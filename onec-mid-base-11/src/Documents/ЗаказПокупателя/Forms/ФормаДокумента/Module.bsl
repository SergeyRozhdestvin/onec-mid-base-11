
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// 29.10 Рождествин Создание реквизита формы Контактное лицо Начало доработки
	Элемент_КонтактноеЛицо = Элементы.Добавить("КонтактноеЛицо_Р2",Тип("ПолеФормы"),Элементы.ГруппаШапкаПраво);
	Элемент_КонтактноеЛицо.ПутьКДанным =  "Объект.КонтактноеЛицо_Р2";
	Элемент_КонтактноеЛицо.Вид =ВидПоляФормы.ПолеВвода;
	Элемент_КонтактноеЛицо.Заголовок = "Контактное Лицо"; 
	 // 29.10. Рождествин Создание на форме элементов Конец доработки
	 // 29.10 Рождествин Создание реквизита формы Согласованная скидка и команды пересчитать таблицу Начало доработки
	ГруппаПересчета = элементы.Вставить("ГруппаШапкаПересчет", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево);  
	ГруппаПересчета.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Элемент_СогласованнаяСкидка = Элементы.Вставить ("СогласованнаяСкидка_Р2", Тип("ПолеФормы"), Элементы.ГруппаШапкаПересчет);
	Элемент_СогласованнаяСкидка.ПутьКДанным = "Объект.СогласованнаяСкидка_Р2";
	Элемент_СогласованнаяСкидка.Вид =ВидПоляФормы.ПолеВвода;
	Элемент_СогласованнаяСкидка.Заголовок = "Согласованная скидка"; 
	Элемент_СогласованнаяСкидка.УстановитьДействие("ПриИзменении","ПриИзмененииСогласованнойСкидки");
	
	Команда = Команды.Добавить("ПересчитатьТаблицу");
	Команда.Заголовок = "Пересчитать Таблицу";
	Команда.Действие = "КомандаПересчитатьТаблицу";
	Элемент_КомандаПересчитатьТаблицу = Элементы.Вставить("ПересчитатьТаблицу", Тип("КнопкаФормы"),Элементы.ГруппаШапкаПересчет);
	Элемент_КомандаПересчитатьТаблицу.ИмяКоманды ="ПересчитатьТаблицу";
	Элемент_КомандаПересчитатьТаблицу.Вид =ВидКнопкиФормы.ОбычнаяКнопка;
	 // 29.10. Рождествин Создание на форме элементов Конец доработки
	
КонецПроцедуры

